rules_version = '2';

// Sicherheitsregeln für Firestore (ADR 003). Deployen mit: firebase deploy --only firestore:rules
// Firestore enthält nur Daten der App, Senderdaten stehen im Code (ADR 011).
// Regeln für songRequests, suggestions und ratings kommen mit den Firestore-Repositories dazu.
service cloud.firestore {
  match /databases/{database}/documents {
    // Alles ist gesperrt, bis es eine eigene Regel bekommt
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
